# Gemini API Keys Pool — Add one or more keys separated by commas
# Supports both AIzaSy... (standard Google Cloud API key) and AQ... (AI Studio session key) formats
# All keys work simultaneously with automatic failover if any key runs out of quota/tokens.
GEMINI_API_KEYS=your_first_gemini_key_here,your_second_gemini_key_here

# Single fallback key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Stripe keys for payment processing
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
